TZ=Asia/Tokyo
COMPOSE_FILE=compose.yaml:compose.tuners.yaml:compose.https.yaml:compose.edcb.yaml:compose.edcb.https.yaml
RECISDB_REPO=https://github.com/stuayu/recisdb-proxy-rs.git
RECISDB_REF=feature/proxy
EPGSTATION_REPO=https://github.com/stuayu/EPGStation.git
EPGSTATION_REF=main
KONOMITV_SOURCE=../KonomiTV
BONCAS_B25_HOST=192.168.1.10
BONCAS_B25_PORT=6900
BONCAS_4K_HOST=192.168.1.10
# BonCasRelay は APDU で B-CAS / ACAS を自動振り分け。4K も既定ポート 6900 を共有。
BONCAS_4K_PORT=6900

RECISDB_WEB_PORT=40080
EPGSTATION_PORT=8888
KONOMITV_PORT=7000
RECISDB_HTTPS_PORT=40443
EPGSTATION_HTTPS_PORT=8443
AKEBI_KEYLESS_SERVER_URL=https://akebi.konomi.tv/
AKEBI_REPO=https://github.com/tsukumijima/Akebi.git
AKEBI_REF=8ddba6a29b858567ab286b5d31daebf2ff683e94
RECORDED_DIR=./data/recorded
VIDEO_GID=44
MARIADB_PASSWORD=
MARIADB_ROOT_PASSWORD=

# compose.amatsukaze.yaml を選択した場合だけ使用。
AMATSUKAZE_VERSION=1.1.1.2
AMATSUKAZE_WEBUI_PORT=32769
# setup.sh が現在のユーザー ID を設定。手動構成では id -u / id -g に合わせる。
RUN_UID=1000
RUN_GID=1000

# EDCB は setup.sh で選択。EDCB/WebUI/BonDriver の ref はコミット SHA にも固定可能。
EDCB_REPO=https://github.com/stuayu/EDCB.git
EDCB_REF=my-build
EDCB_WEBUI_REPO=https://github.com/stuayu/EDCB_Material_WebUI.git
EDCB_WEBUI_REF=dev
EDCB_BONDRIVER_REPO=https://github.com/matching/BonDriver_LinuxMirakc.git
EDCB_BONDRIVER_REF=main
EDCB_WEB_PORT=5510
EDCB_HTTPS_PORT=8553
# 仮想チューナー数。物理チューナーの確保は recisdb-proxy が調停。
EDCB_TUNER_COUNT=2
