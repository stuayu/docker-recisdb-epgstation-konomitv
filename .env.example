TZ=Asia/Tokyo
COMPOSE_FILE=compose.yaml:compose.tuners.yaml
RECISDB_REPO=https://github.com/stuayu/recisdb-proxy-rs.git
RECISDB_REF=feature/proxy
EPGSTATION_REPO=https://github.com/stuayu/EPGStation.git
EPGSTATION_REF=master
KONOMITV_SOURCE=../KonomiTV
BONCAS_B25_HOST=192.168.1.10
BONCAS_B25_PORT=6900
BONCAS_4K_HOST=192.168.1.10
# BonCasRelay は APDU で B-CAS / ACAS を自動振り分け。4K も既定ポート 6900 を共有。
BONCAS_4K_PORT=6900

RECISDB_WEB_PORT=40080
EPGSTATION_PORT=8888
KONOMITV_PORT=7000
RECORDED_DIR=./data/recorded
VIDEO_GID=44
MARIADB_PASSWORD=change-me
MARIADB_ROOT_PASSWORD=change-me-too
